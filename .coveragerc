[run]
source = src
omit =
    src/main.py
    src/financial_operations.py
    src/transactions.py
    */__init__.py
    */conftest.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if False:
    if typing.TYPE_CHECKING:

[html]
directory = htmlcov
